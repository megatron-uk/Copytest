#!/bin/bash

##################################################################
#
# Copytest - A simple file copy transfer speed testing tool
# =========================================================
#
# Uses cp, rsync and dd to provide an analysis of the various
# methods of copying a file from a source and destination location.
# dd is used with various block sizes to find the optimal transfer
# size for the combination of filesystems you are testing.
#
# Requires:
# - bash
# - cp
# - rsync
# - dd
# - bc
# - gnuplot (optional)
#
# Produces a CSV data file of the test results, optionally if you
# have gnuplot installed the output can be plotted directly into
# a chart.
#
# To run, 'source' this file and follow the instructions displayed.
#
#################################################################
#
# See: https://github.com/megatron-uk/Copytest
# For licensing information, see: LICENSE
#
##################################################################


export COUNTSIZE=2000					# Size of the test file, in megabytes
export TESTDATE=`date +%y%m%d_%H%M`		# Timestamp
export TIMEFORMAT=%R					# Control the output of the 'time' command
export RESULTS="copytest.csv"			# Where CSV output goes
export ERRORS="copytest.err"			# Where STDERR messages go
export CHART="copytest.png"				# Name of chart graphic
export CHART_X=1024						# gnuplot chart x res
export CHART_Y=800						# gnuplot chart y res
export SLEEPTIME=5						# How long to pause between tests/test iterations
export GNUPLOT=0						# Do we have gnuplot
export TEST_COL_START=4					# Which column contains the first test data
export TEST_COL_END=16					# Which column contains the last test data


# From: https://stackoverflow.com/questions/2683279/how-to-detect-if-a-script-is-being-sourced	
(return 0 2>/dev/null) && SOURCED=1 || SOURCED=0
	
create_headers() {
	# CSV Header
	HEADER="Copy Task,Date,File size (MBytes),cp,rsync,dd bs=512,dd bs=8k,dd bs=16k,dd bs=32k,dd bs=64k,dd bs=128k,dd bs=256k,dd bs=512k,dd bs=1024k,dd bs=2048k,dd bs=4096k"
	
	echo "Creating CSV File"
	echo "================="
	if [ -f "$RESULTS" ]
	then
		if [ -s "$RESULTS" ]
		then
			# No-op; results exists
			echo "- Ok: Reused existing CSV results file '$RESULTS'"
			echo ""
		else
			# Write headers
			echo "$HEADER" > $RESULTS
			if [ "$?" = "0" ]
			then
				echo "- Ok: Created CSV file '$RESULTS'"
			else
				echo "- Error: Unable to create CSV results file '$RESULTS'"
				return 1
			fi
			echo ""
		fi
	else
		# Create CSV file and write headers
		echo "$HEADER" > $RESULTS
		if [ "$?" = "0" ]
		then
			echo "- Ok: Wrote CSV headers to file '$RESULTS'"
		else
			echo "- Error: Unable to create CSV results file '$RESULTS'"
			return 1
		fi
		echo ""
	fi
}

create_testfile() {
	# Re-use a test file if one already exists
	echo "Creating Output File"
	echo "===================="
	
	if [ -s "$SRC" ]
	then
		echo "Reusing $SRC"
		echo ""
	else
		echo "Creating $SRC ... please wait ... "
		SPEED=`{ time dd if=/dev/random of=$SRC bs=1M count=$COUNTSIZE >/dev/null 2>>$ERRORS; } 2>&1`
		if [ "$?" != "0" ]
        then
            echo ""
			echo "- Error creating $SRC ..."
            cat $ERRORS
            return 1
        fi
		sleep $SLEEPTIME
		sync $SRC
		SPEED=`echo "$SRC_BYTES / $SPEED / 1024 / 1024" | bc`
		echo "- Ok: Created from /dev/random at $SPEED MB/s"
		echo ""
	fi
}

